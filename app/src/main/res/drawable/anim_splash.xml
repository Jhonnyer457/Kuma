<?xml version="1.0" encoding="utf-8"?>
<!-- Logo de Kuma. Se mantiene como AnimationDrawable (Animatable) porque el codigo
     llama a (drawable as Animatable).start(). Un solo fotograma = imagen estatica. -->
<animation-list xmlns:android="http://schemas.android.com/apk/res/android"
    android:oneshot="true">
    <item
        android:drawable="@drawable/kuma_logo"
        android:duration="1000" />
</animation-list>
